# Local development secrets.
#
# Do NOT commit real values. Either copy this file to .env and fill it in, or
# let `make env` generate a .env with random values for you. The gateway has no
# default signing secret on purpose: it refuses to start without one.
#
#   openssl rand -hex 32   -> ZTAG_JWT_SECRET
#   openssl rand -hex 24   -> ZTAG_ADMIN_TOKEN
#
ZTAG_JWT_SECRET=
ZTAG_ADMIN_TOKEN=
